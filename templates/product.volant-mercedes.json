dd('copied');\n        setTimeout(function() {\n          copyBtn.innerHTML = originalHTML;\n          copyBtn.classList.remove('copied');\n        }, 2000);\n      });\n    });\n  }\n});\n</script>\n\n<style>\n.phone-banner-compact {\n  width: 100%;\n  max-width: 500px;\n  margin: 1.5rem auto;\n}\n\n.phone-banner-compact__wrapper {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  padding: 1rem 1.25rem;\n  background: linear-gradient(45deg, #1e3a8a, #3b82f6, #1e3a8a, #3b82f6);\n  background-size: 300% 300%;\n  animation: gradient-shift 4s ease infinite;\n  border-radius: 12px;\n  box-shadow: 0 4px 12px rgba(30, 58, 138, 0.25);\n}\n\n.phone-banner-compact__info {\n  display: flex;\n  align-items: center;\n  gap: 0.875rem;\n  color: white;\n}\n\n.phone-banner-compact__info > svg {\n  flex-shrink: 0;\n}\n\n.phone-banner-compact__label {\n  display: block;\n  font-size: 0.9rem;\n  color: #e0e7ff;\n  font-weight: 600;\n  margin-bottom: 0.25rem;\n  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);\n}\n\n.phone-banner-compact__number {\n  display: block;\n  font-size: 1.25rem;\n  font-weight: 700;\n  color: white;\n  text-decoration: none;\n  letter-spacing: 0.025em;\n  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.15);\n}\n\n.phone-banner-compact__number:hover {\n  text-decoration: underline;\n}\n\n.phone-banner-compact__copy {\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 40px;\n  height: 40px;\n  background: rgba(255, 255, 255, 0.2);\n  border: none;\n  border-radius: 8px;\n  color: white;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  backdrop-filter: blur(10px);\n}\n\n.phone-banner-compact__copy:hover {\n  background: rgba(255, 255, 255, 0.3);\n  transform: scale(1.05);\n}\n\n.phone-banner-compact__copy.copied {\n  background: rgba(16, 185, 129, 0.9);\n}\n\n@media screen and (max-width: 640px) {\n  .phone-banner-compact {\n    margin: 1rem auto;\n  }\n  \n  .phone-banner-compact_