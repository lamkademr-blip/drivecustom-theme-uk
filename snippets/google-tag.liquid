{% comment %}
  Google tag (gtag.js) — Drive Custom UK.
  GT-WBL9TTZ9 is the combined Google tag, G-DJLVTVZT9F the GA4 destination.
  Theme settings > Tracking > "GA4 Measurement ID" overrides the G- id if set.
{% endcomment %}
{%- liquid
  assign ga4_id = settings.ga4_measurement_id
  if ga4_id == blank
    assign ga4_id = 'G-DJLVTVZT9F'
  endif
-%}
<script async src="https://www.googletagmanager.com/gtag/js?id=GT-WBL9TTZ9"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'GT-WBL9TTZ9');
  gtag('config', '{{ ga4_id }}');
</script>
