{% comment %}
  FAQPage structured data for /pages/faq.
  Keep in sync with the FAQ page body (Shopify admin > Pages > FAQ):
  same questions, plain-text version of the answers.
  Rendered from theme.liquid only on page.handle == 'faq'.
{% endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Are custom steering wheels legal in the UK?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. There is no law against replacing your steering wheel. The only requirement is that your car stays as safe as it was designed: if it originally had a driver's airbag, that airbag must remain present and working. Every Drive Custom wheel retains your original airbag, so the upgrade is fully road legal."
      }
    },
    {
      "@type": "Question",
      "name": "Will a custom steering wheel pass the MOT?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The MOT checks that the airbag is present with no warning light, the wheel is secure and the horn works. Our wheels are built on an original-specification core and reuse your airbag and buttons, so there is nothing for the tester to fail. Material, colour and shape are not part of the test."
      }
    },
    {
      "@type": "Question",
      "name": "What happens to my airbag and buttons?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "They transfer over. Your original airbag, multifunction buttons and paddles fit the new wheel exactly as they fitted the old one — the electrical connections are unchanged, so there are no warning lights and no coding needed."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to tell my insurance company about a custom steering wheel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — UK insurers expect you to declare any modification, including a custom steering wheel. It usually takes a phone call and has little or no effect on the premium, but an undeclared modification can cause problems with a claim, so always declare it."
      }
    },
    {
      "@type": "Question",
      "name": "Can I customise my steering wheel exactly how I want?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You can choose materials, colours, stitching and finishes from the options available on our site — and even more by contacting us directly. Every steering wheel is made to order based on your choices."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to receive a custom steering wheel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Production and delivery usually take 2 to 5 weeks, depending on the complexity of the customisation and your delivery location. You receive a confirmation email with tracking as soon as your order ships."
      }
    },
    {
      "@type": "Question",
      "name": "Can I cancel or change my order?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Custom orders are final once confirmed, as every steering wheel is made to order. Please make sure all your choices are correct before confirming."
      }
    },
    {
      "@type": "Question",
      "name": "How long is the warranty on your steering wheels?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "All our steering wheels come with a 5-year commercial warranty, covering manufacturing defects and compatibility issues with your vehicle. It does not cover normal wear, scratches, impacts or damage caused by misuse."
      }
    },
    {
      "@type": "Question",
      "name": "Do you ship internationally and how much is delivery?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we deliver worldwide and delivery is free. Delivery times may vary depending on your country."
      }
    },
    {
      "@type": "Question",
      "name": "Can I return my steering wheel if I change my mind?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No — custom steering wheels cannot be returned due to a change of mind, as they are made to order specifically for you. Faults covered by the 5-year warranty are repaired or replaced with return shipping covered by us."
      }
    },
    {
      "@type": "Question",
      "name": "Do you help with installation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We provide detailed instructions and guides for every model, but we do not carry out the installation. We recommend using a professional if you are unsure — we can put you in touch with one near you."
      }
    }
  ]
}
</script>
