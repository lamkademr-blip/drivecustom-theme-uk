{% comment %}
  Product structured data (JSON-LD) for rich snippets in Google Search.
  Outputs: name, image, description, brand, sku, price, availability.
  Deliberately does NOT output aggregateRating — see the note next to the offers block.
{% endcomment %}

{%- if request.page_type == 'product' -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_description = product.description | strip_html | strip_newlines | truncate: 5000 | escape
  if product_description == blank or product_description.size < 10
    assign product_description = product.title | escape
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": "{{ canonical_url }}",
  "image": [
    {%- for image in product.images limit: 5 -%}
      "{{ image | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "description": {{ product_description | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: shop.name | json }}
  },
  {%- if current_variant.sku != blank -%}
  "sku": {{ current_variant.sku | json }},
  {%- endif -%}
  {%- if current_variant.barcode != blank -%}
  "gtin": {{ current_variant.barcode | json }},
  {%- endif -%}
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": {{ product.price_min | money_without_currency | strip | replace: ' ', '' | replace: ',', '.' }},
    "highPrice": {{ product.price_max | money_without_currency | strip | replace: ' ', '' | replace: ',', '.' }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "offerCount": {{ product.variants.size }},
    "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": "{{ canonical_url }}"
  }
  {%- comment -%}
    No aggregateRating is emitted on purpose.

    Google's review snippet policy requires marked-up ratings to correspond to review
    content that is visible on the same page. The reviews.rating metafields were carried
    over from the French store during migration and no review app renders them here, so
    emitting them would mark up ratings a visitor could never see — the textbook trigger
    for a "spammy structured markup" manual action.

    Only reinstate this once a review app is installed AND genuine reviews render on the
    product page itself.
  {%- endcomment -%}
}
</script>
{%- endif -%}
